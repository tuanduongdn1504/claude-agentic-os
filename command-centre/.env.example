# Command Centre — starter env. Copy to .env and edit.

# Where the dashboard binds. Default 127.0.0.1:8765.
CC_HOST=127.0.0.1
CC_PORT=8765

# Absolute path to the install directory. install.sh fills this in.
CC_INSTALL_DIR=

# Absolute path to the project you want Mission Control to dispatch from.
# This is the cwd used for `claude -p` child processes.
CC_PROJECT_ROOT=

# Default model for dispatcher-launched tasks when a skill doesn't pick one.
MISSION_CONTROL_DEFAULT_MODEL=claude-sonnet-4-6

# Max concurrent running tasks in the dispatcher.
# Back-pressure: when running >= this, run_once() defers all new claims
# and the AttentionBar shows a `back_pressure` issue.
MISSION_CONTROL_MAX_CONCURRENT=3

# Daily cost cap (USD). When today's summed task cost reaches this number,
# the dispatcher refuses to claim anything new and the AttentionBar shows a
# `cost_capped` issue. Unset / 0 = no cap.
# MISSION_CONTROL_DAILY_COST_CAP_USD=20.00

# Hard risk gate. When set (default), tasks created with
# risk_level=high AND requires_approval=False are auto-promoted to
# awaiting_approval at claim time and never auto-dispatch. Disable only
# if you've sanitized your task creation pipeline.
MISSION_CONTROL_HARD_RISK_GATE=1

# Per-task timeout in seconds (classic + stream modes).
TASK_TIMEOUT_SECONDS=1800

# Telegram — only needed if you opted in. setup_telegram.py wizard writes these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DASH_CHAT_ID=

# Override the displayed timezone label. Leaves os default if empty.
TZ=

# Claude Code's env marker. Leave set if dispatcher needs it.
# CLAUDE_CODE_MAX_RETRIES is read at /api/system/pressure time. Default 10.
CLAUDE_CODE_MAX_RETRIES=10

# Experimental: use FSEvents (watchdog) for sub-2s JSONL → DB lag.
# Default is the 120s polling loop, which is proven and zero-dep.
# Requires `pip install watchdog>=4.0`. Off by default.
# CC_USE_FSEVENTS=1
